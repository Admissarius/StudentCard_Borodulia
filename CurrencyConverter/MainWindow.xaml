<Window x:Class="CurrencyConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurrencyConverter"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="400">

    <GroupBox Header="Конвертер валют" Margin="20" FontSize="16">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Поле ввода -->
            <TextBox x:Name="InputValue"
                 Text="1"
                 Grid.Row="0"
                 Height="30"
                 FontSize="16"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,10"/>

            <!-- Выбор направления конвертации -->
            <ComboBox x:Name="ConversionSelector"
                  Grid.Row="1"
                  Height="30"
                  FontSize="16"
                  Margin="0,0,0,10"
                  SelectedIndex="1">
                <ComboBoxItem Content="BYN → USD"/>
                <ComboBoxItem Content="USD → BYN"/>
                <ComboBoxItem Content="BYN → EUR"/>
                <ComboBoxItem Content="EUR → BYN"/>
                <ComboBoxItem Content="BYN → RUB"/>
            </ComboBox>

            <!-- Кнопка -->
            <Button Content="Конвертировать"
                Grid.Row="2"
                Height="30"
                FontSize="16"
                Click="Convert_Click"/>

            <!-- Результат -->
            <TextBlock x:Name="ResultText"
                   Grid.Row="3"
                   FontSize="18"
                   Margin="0,10,0,0"
                   Foreground="DarkBlue"/>
        </Grid>
    </GroupBox>
</Window>
