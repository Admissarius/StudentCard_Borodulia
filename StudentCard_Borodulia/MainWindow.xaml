<Window x:Class="StudentCard_Borodulia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentCard_Borodulia"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        ResizeMode="NoResize">

    <!-- Main Container -->
    <Grid Margin="10" Background="{DynamicResource {x:Static SystemColors.AppWorkspaceBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Заоловок-->
        <TextBlock HorizontalAlignment="Center" 
            TextWrapping="Wrap" 
            Text="Профиль студента" 
            VerticalAlignment="Center" 
            TextAlignment="Center" Margin="0,10,0,10" FontSize="20" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <!-- ТУТ ХЗ ЧТО ДОЛЖНО БЫТЬ-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>




            <!-- Левая колонка формы -->
            <StackPanel Margin="0,0,10,0" MaxWidth="510">

                <GroupBox Header="Личная информация" 
                  Margin="5,0,10,0" Height="125">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="41*"/>
                            <ColumnDefinition Width="120*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <Label x:Name="lbFirstName" Content="Имя:"/>
                            <Label x:Name="lbLastName" Content="Фамилия:"/>
                            <Label x:Name="lbAge" Content="Возраст:"/>
                            <Label x:Name="lbGender" Content="Пол:"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="txtFirstName" TextWrapping="Wrap" 
                     Text="TextBox" Width="350" Height="20" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                            <TextBox x:Name="txtLastName" TextWrapping="Wrap" 
                     Text="TextBox" Width="350" Height="20" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                            <TextBox x:Name="txtAge" TextWrapping="Wrap" 
                     Text="TextBox" Width="350" Height="20" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                            <StackPanel Height="49" Orientation="Horizontal">
                                <RadioButton x:Name="rbMale" Content="Мужской" Margin="0,10,0,0"/>
                                <RadioButton x:Name="rbFemale" Content="Женский" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Контакты" Margin="5,0,10,10" Height="72">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="41*"/>
                            <ColumnDefinition Width="120*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Email"/>
                            <Label Content="Телефон"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBox x:Name="txtEmail" TextWrapping="Wrap" Text="TextBox" Width="350" Height="20" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                            <TextBox x:Name="txtPhone" TextWrapping="Wrap" Text="TextBox" Width="350" Height="20" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Обучение" Margin="5,0,10,5" Height="82">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="41*"/>
                            <ColumnDefinition Width="120*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <Label Content="Курс"/>
                            <Label Content="Специализация:"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="cmbCourse" Width="350" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <Button Content="1"/>
                                <Button Content="2"/>
                                <Button Content="3"/>
                                <Button Content="4"/>
                            </ComboBox>
                            <ComboBox x:Name="cmbSpecialization" Width="350" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Программирование"/>
                                <ComboBoxItem Content="Дизайн"/>
                                <ComboBoxItem Content="Сети"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    
                </GroupBox>
            </StackPanel>

            <!-- Правая колонка с фото -->
            <StackPanel Grid.Column="1" Margin="0,10,0,0" MaxWidth="260">
                <Border BorderThickness="1" Height="246" 
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,0,10,0">
                    
                    <Image Name="imgPhoto" Stretch="Uniform"/>
                    
                </Border>
                <Button x:Name="btnLoadPhoto" Content="Загрузить фото" 
                        Height="28" Width="220" HorizontalAlignment="Center" 
                        Margin="0,10,0,0"/>
            </StackPanel>

        </Grid>

        <!-- Копки действий -->
        <Button Content="Очистить" 
                Margin="20,0,0,5" HorizontalAlignment="Left" 
                Grid.Row="2" 
                VerticalAlignment="Center" Height="28" Width="220" Click="btnClear_Click"/>

        <Button Content="Сохранить" 
                HorizontalAlignment="Right" 
                Margin="0,0,20,5" 
                Grid.Row="2" 
                VerticalAlignment="Center" Height="28" Width="220" Click="btnSave_Click"/>

    </Grid>
</Window>
